generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Boutique {
  id             Int         @id @default(autoincrement())
  nom            String
  sousDomaine    String      @unique
  activite       String
  dateCreation   DateTime    @default(now())
  solde          Decimal     @default(0.00) @db.Decimal(10, 2)
  proprietaire   Utilisateur @relation("ProprietaireBoutique", fields: [proprietaireId], references: [id])
  proprietaireId Int         @unique

  commandes Commande[]
  paiements Paiement[]
  produits  Produit[]

  @@map("boutiques")
}

model Utilisateur {
  id                Int       @id @default(autoincrement())
  nom_complet       String
  email             String    @unique
  mot_de_passe      String
  role              String    @default("acheteur")
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  commandes  Commande[]
  maBoutique Boutique?  @relation("ProprietaireBoutique")

  @@map("utilisateurs")
}

model Produit {
  id           Int      @id @default(autoincrement())
  nom          String
  description  String?  @db.Text
  prix         Decimal  @db.Decimal(10, 2)
  stock        Int      @default(0)
  // MODIFICATION ICI : Ajout de @db.Text pour accepter les URLs longues
  image_url    String?  @db.Text
  dateCreation DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  boutiqueId Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)

  @@index([boutiqueId])
  @@map("produits")
}

model Commande {
  id              Int      @id @default(autoincrement())
  totalPrix       Decimal  @db.Decimal(10, 2)
  fraisPlateforme Decimal  @db.Decimal(10, 2)
  methodePaiement String?
  statutCommande  String   @default("en_attente")
  dateCommande    DateTime @default(now())
  nomClient       String
  telephone       String
  adresse         String   @db.Text

  items Json

  boutiqueId    Int
  utilisateurId Int?

  boutique    Boutique     @relation(fields: [boutiqueId], references: [id])
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])
  paiements   Paiement[]

  @@index([boutiqueId])
  @@index([utilisateurId])
  @@map("commandes")
}

model Paiement {
  id              Int      @id @default(autoincrement())
  methodePaiement String
  statutPaiement  String   @default("en_attente")
  montant         Decimal  @db.Decimal(10, 2)
  transactionId   String?  @unique
  datePaiement    DateTime @default(now())

  commandeId Int
  boutiqueId Int

  boutique Boutique @relation(fields: [boutiqueId], references: [id])
  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([boutiqueId])
  @@index([commandeId])
  @@map("paiements")
}